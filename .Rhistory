SCMEB = data3[1:30, 3], SpaGCN = data10[1:30,3],
BANKSY = data7[1:30, 3], STAGATE = data8[1:30, 3],
DRSC = data5[1:30, 3], Louvain = data9[1:30, 3],
GraphST = data11[1:30, 3], ADEPT = data12[1:30, 3])
library(reshape2)
data = melt(data_ARI)
colnames(data) = c("Method", "NMI")
library(ggplot2)
return(data)
}
